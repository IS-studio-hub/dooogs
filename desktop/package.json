{
  "name": "dooogs-os",
  "version": "0.1.0",
  "private": true,
  "description": "dooogs OS — local Jarvis-style assistant with always-on MCP connections",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5177 && electron .\"",
    "build:ui": "vite build",
    "start": "electron .",
    "pack": "npm run build:ui && electron-builder --mac dir",
    "dist": "npm run build:ui && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.dooogs.os",
    "productName": "dooogs OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "config/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "electron-store": "^10.0.0",
    "openai": "^4.104.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
